#!/bin/sh
set -eu

ROOT="${DPKG_ROOT:-}"

if [ "$1" = "configure" ] || [ "$1" = "triggered" ]; then
    # Prefer LeiOS as the default dpkg vendor.
    if [ ! -e "${ROOT}/etc/dpkg/origins/default" ] || \
       [ "$(readlink -f "${ROOT}/etc/dpkg/origins/default" 2>/dev/null)" != "${ROOT}/etc/dpkg/origins/leios" ]; then
        ln -sf leios "${ROOT}/etc/dpkg/origins/default"
    fi

    if [ -x "${ROOT}/usr/share/leios/system/utils/base-files/install.sh" ]; then
        "${ROOT}/usr/share/leios/system/utils/base-files/install.sh"
    fi
fi

#DEBHELPER#
