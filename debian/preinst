#!/bin/sh
set -eu

PACKAGE="leios.system.base-files"
ROOT="${DPKG_ROOT:-}"

if [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then

    for f in /usr/lib/os-release /etc/lsb-release /etc/issue /etc/issue.net /etc/legal /etc/motd; do
        dpkg-divert --root "${ROOT:-/}" --package "$PACKAGE" --add --rename \
            --divert "${f}.base-files" "$f" || true
    done
fi

#DEBHELPER#
